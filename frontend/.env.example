# DecisionHub Frontend Environment Variables
# API Base URL (default is http://localhost:8080/api for local dev)
VITE_API_URL=http://localhost:8080/api

# WebSocket Endpoint URL (optional, defaults to deriving /ws from VITE_API_URL)
VITE_WS_URL=http://localhost:8080/ws

# Google OAuth 2.0 Client ID (obtain from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=702442008383-5cuppuqs826ofhvmio3m0k7q53u0m8cu.apps.googleusercontent.com

