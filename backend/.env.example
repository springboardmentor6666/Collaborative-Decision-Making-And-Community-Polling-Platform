# Backend PostgreSQL connection (used as environment variables when running Spring Boot)
DB_URL=jdbc:postgresql://localhost:5432/decisionhub
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-postgresql-password

# Optional: comma-separated origins permitted to call the backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional frontend overrides. Leave VITE_API_BASE_URL unset to use the Vite proxy.
# VITE_BACKEND_URL=http://localhost:8081
# VITE_API_BASE_URL=https://api.example.com/api
