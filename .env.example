# ==============================================================================
# DecisionHub Production Environment Configuration Template (.env)
# Copy this file to `.env` in the project root before running docker compose.
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=decisionhub_db
POSTGRES_USER=decisionhub_user
POSTGRES_PASSWORD=super_secure_postgres_password_here

# Backend JWT Security (Must be at least 256 bits / 32+ characters)
JWT_SECRET_KEY=9a4f6c8b1d3e5f7a2b4c6d8e0f1a3b5c7d9e1f3a5b7c9d1e3f5a7b9c1d3e5f7a

# CORS & Frontend URLs (Set to your live domain or server IP in production)
FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# Optional: Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Frontend Client Build Arguments
VITE_API_URL=/api
VITE_WS_URL=/ws

# Automated Initial Admin Account Seeding
# Configured default credentials for deployment:
ADMIN_INITIAL_EMAIL=admin@decisionhub.com
ADMIN_INITIAL_PASSWORD=Admin123!
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_FULL_NAME=System Administrator
